{
  "name": "experiment8",
  "version": "0.1.1",
  "description": "PersonalAgent desktop app for local projects",
  "scripts": {
    "dev": "eve dev --host 127.0.0.1",
    "build": "eve build",
    "start": "eve start --host 127.0.0.1",
    "login": "tsx scripts/account.ts login",
    "logout": "tsx scripts/account.ts logout",
    "auth:status": "tsx scripts/account.ts status",
    "models": "tsx scripts/account.ts models",
    "model": "tsx scripts/account.ts model",
    "reasoning": "tsx scripts/account.ts reasoning",
    "test:live": "tsx scripts/smoke.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:host": "tsx scripts/host-smoke.ts",
    "desktop:build": "node scripts/desktop-build.mjs",
    "desktop": "npm run desktop:build && node scripts/desktop-start.mjs",
    "desktop:package": "npm run desktop:build && node scripts/desktop-package.mjs",
    "test:security": "tsx --test test/security.test.ts",
    "test:desktop:live": "tsx scripts/desktop-live-check.ts",
    "release:artifacts": "npm run desktop:package && node scripts/release-artifacts.mjs",
    "pretest": "npm run desktop:build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@ai-sdk/provider": "4.0.10",
    "@earendil-works/pi-ai": "0.85.1",
    "ai": "7.0.99",
    "croner": "10.0.1",
    "defu": "6.1.7",
    "destr": "2.0.5",
    "eve": "0.54.3",
    "proper-lockfile": "4.1.2",
    "rendu": "0.1.0",
    "scule": "1.3.0",
    "source-map": "0.8.0",
    "ufo": "1.6.4",
    "unctx": "3.0.1",
    "youch": "4.1.1",
    "youch-core": "0.3.3",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@types/node": "22.20.2",
    "@types/proper-lockfile": "4.1.4",
    "electron": "44.3.0",
    "esbuild": "0.25.12",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  },
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "productName": "PersonalAgent",
  "main": "desktop-dist/main.mjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/Baker-Harrison/PersonalAgent.git"
  }
}
